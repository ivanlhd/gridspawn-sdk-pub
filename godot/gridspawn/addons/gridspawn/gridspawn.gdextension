[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = false

[libraries]
linux.debug.x86_64 = "res://addons/gridspawn/bin/libgridspawn_godot.linux.x86_64.so"
linux.release.x86_64 = "res://addons/gridspawn/bin/libgridspawn_godot.linux.x86_64.so"
windows.debug.x86_64 = "res://addons/gridspawn/bin/gridspawn_godot.windows.x86_64.dll"
windows.release.x86_64 = "res://addons/gridspawn/bin/gridspawn_godot.windows.x86_64.dll"
